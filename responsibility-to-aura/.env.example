# Confluence Cloud (also used for Jira user-search on the same tenant)
CLOUD_BASE_URL=https://your-tenant.atlassian.net/wiki
CLOUD_EMAIL=you@example.com
CLOUD_API_TOKEN=your-cloud-api-token

# Confluence Data Center (only needed by dc/probe_dc.js and dc/extract_dc.js)
# DC_BASE_URL=https://confluence.your-company.com
# DC_USERNAME=admin
# DC_PASSWORD=password-or-personal-access-token

# Optional: enable verbose stack traces on fatal errors
# DEBUG=1
