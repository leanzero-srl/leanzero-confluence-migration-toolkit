# Confluence Data Center base URL (include context path if applicable, no trailing slash)
# Example: https://confluence.company.com or https://company.com/confluence
CONFLUENCE_DC_BASE_URL=https://confluence.company.com

# Admin credentials for basic auth (user must have Confluence admin privileges).
# These are IGNORED if CONFLUENCE_DC_BASIC_AUTH below is set.
CONFLUENCE_DC_USERNAME=admin
CONFLUENCE_DC_PASSWORD=your_password_here

# Optional: pre-base64-encoded "username:password" (or "username:PAT").
# When set, this takes precedence over CONFLUENCE_DC_USERNAME / CONFLUENCE_DC_PASSWORD.
# Generate with:  echo -n 'admin:your_password_here' | base64
# CONFLUENCE_DC_BASIC_AUTH=YWRtaW46eW91cl9wYXNzd29yZF9oZXJl

# Dry run mode - set to true to preview without making changes
DRY_RUN=false

# ── Confluence Cloud (used by restore_restrictions_cloud.js) ──────────────────

# Cloud instance URL (include /wiki, no trailing slash)
CONFLUENCE_CLOUD_BASE_URL=https://company.atlassian.net/wiki

# Atlassian account email for Cloud API auth.
# Ignored if CONFLUENCE_CLOUD_BASIC_AUTH below is set.
CONFLUENCE_CLOUD_EMAIL=your_email@company.com

# Cloud API token (generate at https://id.atlassian.com/manage-profile/security/api-tokens)
# Ignored if CONFLUENCE_CLOUD_BASIC_AUTH below is set.
CONFLUENCE_CLOUD_API_TOKEN=your_cloud_api_token_here

# Optional: pre-base64-encoded "email:apiToken".
# When set, takes precedence over CONFLUENCE_CLOUD_EMAIL / CONFLUENCE_CLOUD_API_TOKEN.
# Generate with:  echo -n 'me@company.com:your_cloud_api_token_here' | base64
# CONFLUENCE_CLOUD_BASIC_AUTH=bWVAY29tcGFueS5jb206eW91cl9jbG91ZF9hcGlfdG9rZW5faGVyZQ==
