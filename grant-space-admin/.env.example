# Confluence Cloud (Basic Auth)
# CLOUD_BASE_URL must include the /wiki path.
# CLOUD_API_TOKEN may be either a raw API token (will be encoded email:token
# into Basic auth) or a pre-encoded base64("email:token") value — auto-detected.
CLOUD_BASE_URL=https://your-site.atlassian.net/wiki
CLOUD_EMAIL=you@example.com
CLOUD_API_TOKEN=your-token-or-prebase64
