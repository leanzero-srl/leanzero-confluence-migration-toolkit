# Confluence Data Center (Basic Auth)
DC_BASE_URL=https://wiki-staging.example.com
DC_USERNAME=your-dc-username
DC_PASSWORD=your-dc-password

# Confluence Cloud (Basic Auth with email:api_token)
CLOUD_BASE_URL=https://your-tenant.atlassian.net/wiki
CLOUD_EMAIL=you@example.com
CLOUD_API_TOKEN=your-cloud-api-token
